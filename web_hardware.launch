<launch>
  <arg name="map_file" />
  <node name="map_server" pkg="map_server" type="map_server" args="$(arg map_file)" />
  <node name="base_to_laser" pkg="tf" type="static_transform_publisher"
        args="0.065 0.0 0.08 3.14159265 0.0 0.0 base_footprint laser_frame 10" />
  <node name="amcl" pkg="amcl" type="amcl">
    <rosparam file="$(find myagv_navigation)/param/amcl.yaml" command="load" />
  </node>
  <node pkg="move_base" type="move_base" name="move_base" output="screen">
    <remap from="cmd_vel" to="/myagv/input_vel" />
    <rosparam file="$(find myagv_navigation)/param/costmap_common_params.yaml" command="load" ns="global_costmap" />
    <rosparam file="$(find myagv_navigation)/param/costmap_common_params.yaml" command="load" ns="local_costmap" />
    <rosparam>
      base_global_planner: global_planner/GlobalPlanner
      base_local_planner: base_local_planner/TrajectoryPlannerROS
      planner_frequency: 1.0
      planner_patience: 5.0
      controller_frequency: 10.0
      controller_patience: 3.0
      recovery_behavior_enabled: false
      clearing_rotation_allowed: false
      shutdown_costmaps: false
      GlobalPlanner: {allow_unknown: false, default_tolerance: 0.0}
      TrajectoryPlannerROS:
        max_vel_x: 0.1
        min_vel_x: 0.02
        max_vel_theta: 0.2
        min_vel_theta: -0.2
        min_in_place_vel_theta: 0.03
        escape_vel: -0.02
        acc_lim_x: 0.2
        acc_lim_y: 0.2
        acc_lim_theta: 0.3
        holonomic_robot: false
        yaw_goal_tolerance: 0.05
        xy_goal_tolerance: 0.03
        latch_xy_goal_tolerance: true
        sim_time: 1.5
        sim_granularity: 0.025
        vx_samples: 8
        vtheta_samples: 20
        meter_scoring: true

      global_costmap:
        global_frame: map
        robot_base_frame: base_footprint
        transform_tolerance: 0.5
        update_frequency: 5.0
        publish_frequency: 5.0
        always_send_full_costmap: true
        footprint: []
        robot_radius: 0.25
        footprint_padding: 0.01
        rolling_window: false
        plugins:
          - {name: static_layer, type: "costmap_2d::StaticLayer"}
          - {name: obstacle_layer, type: "costmap_2d::ObstacleLayer"}
          - {name: inflation_layer, type: "costmap_2d::InflationLayer"}
        static_layer:
          enabled: true
          map_topic: /navigation_map
          first_map_only: false
          subscribe_to_updates: false
          track_unknown_space: true
        obstacle_layer:
          enabled: true
          combination_method: 1
        inflation_layer:
          enabled: true
          inflation_radius: 0.4
          cost_scaling_factor: 5.0
      local_costmap:
        global_frame: map
        robot_base_frame: base_footprint
        transform_tolerance: 0.5
        update_frequency: 5.0
        publish_frequency: 5.0
        always_send_full_costmap: true
        footprint: []
        robot_radius: 0.25
        footprint_padding: 0.01
        rolling_window: true
        plugins:
          - {name: static_layer, type: "costmap_2d::StaticLayer"}
          - {name: obstacle_layer, type: "costmap_2d::ObstacleLayer"}
          - {name: inflation_layer, type: "costmap_2d::InflationLayer"}
        static_layer:
          enabled: true
          map_topic: /navigation_map
          first_map_only: false
          subscribe_to_updates: false
          track_unknown_space: true
        obstacle_layer:
          enabled: true
          combination_method: 1
        inflation_layer:
          enabled: true
          inflation_radius: 0.4
          cost_scaling_factor: 5.0
        width: 4.0
        height: 4.0
        resolution: 0.05
    </rosparam>
  </node>
</launch>
